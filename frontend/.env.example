# The site is built from the files `python build_dataset.py` writes.
# None of these are needed for a normal local build.

# Where the build's output is (default: ../dist, relative to frontend/).
# SITE_DATA_DIR=../dist

# Build from the committed copy in src/data/ instead (Vercel does this automatically).
# Refresh the copy with: npm run data:copy
# SITE_DATA=snapshot

# Optional: override the map basemap style URL (defaults to OpenFreeMap bright)
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
