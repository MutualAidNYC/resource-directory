/api/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Browsers use the Content-Type as sent and never guess (also set in src/handler.ts).
/*
  X-Content-Type-Options: nosniff

# Until launch: keep the dev site out of search engines (also set in src/handler.ts).
/*
  X-Robots-Tag: noindex
