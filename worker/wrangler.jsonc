{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "resource-directory",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "preview_urls": false,
    // The list data the build writes (static_build/worker_data.py), built into the code.
    "alias": { "worker-data": "../dist/worker-data/data.json" },
    "assets": {
        // Everything public: the site and the API's static files.
        "directory": "../dist/public",
        "binding": "ASSETS",
        // Code runs first only for these. Everything else is a static file; a missing one
        // falls through to the code, which answers with a 404.
        "run_worker_first": [
            "/api",
            "/api/",
            "/api/services",
            "/api/organizations",
            "/api/service_at_locations",
            "/api/taxonomies",
            "/api/taxonomy_terms"
        ]
    },
    // The daily rebuild (src/rebuild.ts), 10:07 UTC. Needs the DEPLOY_HOOK_URL secret.
    // The hourly check (src/alerts.ts), at :17. Needs ALERTS_WEBHOOK_URL,
    // ANALYTICS_API_TOKEN and ACCOUNT_ID. src/index.ts picks the job by these strings.
    "triggers": { "crons": ["7 10 * * *", "17 * * * *"] },
    // When this version was deployed: the hourly check reports a version over a day old.
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "observability": {
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
        "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
    },
    "send_metrics": false,
    "env": {
        // The preview Worker, resource-directory-preview: a Preview URL for every branch,
        // built from production's data (scripts/build.sh preview). Inherits the rest.
        "preview": {
            "previews": {},
            // Overrides the top-level false; otherwise each deploy turns Preview URLs off.
            "preview_urls": true,
            // No daily rebuild or hourly check: triggers are inherited otherwise.
            "triggers": { "crons": [] }
        }
    }
}
