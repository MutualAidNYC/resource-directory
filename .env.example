# Airtable Configuration
AIRTABLE_API_KEY=your_personal_access_token_here
AIRTABLE_BASE_ID=your_base_id_here

# Tables and fields the static build requests. Defaults to airtable.toml.
# AIRTABLE_CONFIG=airtable.toml

# Sync Settings
SYNC_INTERVAL_MINUTES=15

# Server Settings — used when running `python main.py`.
# The Dockerfile and the documented uvicorn command set these themselves;
# in Docker, remap the port with docker-compose's `ports:` instead.
HOST=127.0.0.1
PORT=8080

# Browser-facing API URL, baked into the frontend image at build time.
# Only needed when the API has a public URL; defaults to localhost:8080.
# NEXT_PUBLIC_API_URL=https://api.example.org
